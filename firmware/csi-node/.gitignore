# ESP-IDF build output — regenerated by `idf.py build`, never versioned.
build/
build-*/

# Generated sdkconfig files — regenerated from sdkconfig.defaults + Kconfig
# on every machine. Only sdkconfig.defaults (hand-authored) is versioned;
# the rest are machine-generated and would only add noise and conflicts.
sdkconfig
sdkconfig.*
!sdkconfig.defaults
