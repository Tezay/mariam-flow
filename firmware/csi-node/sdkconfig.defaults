# Defaults for the csi-node firmware (target: esp32c6).
# CSI extraction must be compiled into the Wi-Fi driver.
CONFIG_ESP_WIFI_CSI_ENABLED=y
# High console baud rate: CSI lines are large and frequent; the default
# 115200 would throttle (and block) the serial output. The baud is only
# settable when the console channel is "Custom UART", so select that
# first (still UART0 — the same USB-serial bridge port), then raise it.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
